#!/bin/sh
# Rejects pushes to main or master, and pushes of any commit without an
# approval note naming it. Reviewers record an approval with
#
#   git notes --ref=approvals add -m "approved <full sha>" <full sha>
#
# Agents are told never to write approval notes themselves. This hook
# stops them from pushing an unreviewed commit by mistake. Install it as
# .git/hooks/pre-push.

status=0
while read -r local_ref local_sha remote_ref _; do
	[ -n "$local_ref" ] || continue
	case "$remote_ref" in
	refs/heads/main | refs/heads/master)
		echo "pre-push: pushing to ${remote_ref#refs/heads/} is not allowed" >&2
		status=1
		continue
		;;
	refs/notes/*) continue ;;
	esac
	case "$local_sha" in
	*[!0]*) ;;
	*) continue ;; # deleting a remote branch
	esac
	commit=$(git rev-parse --verify --quiet "${local_sha}^{commit}") || {
		echo "pre-push: cannot resolve $local_sha to a commit" >&2
		status=1
		continue
	}
	note=$(git notes --ref=approvals show "$commit" 2>/dev/null | head -n 1)
	if [ "$note" != "approved $commit" ]; then
		echo "pre-push: $commit has no approval note" >&2
		status=1
	fi
done
exit "$status"
